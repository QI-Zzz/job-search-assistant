{
    "name": "LinkedIn Job Saver",
    "description": "Save interesting jobs to your database with one click.",
    "version": "1.0.0",
    "manifest_version": 3,

    "background": {
        "service_worker": "src/background.js"
    },

    "content_scripts": [
        {
            "matches": ["https://www.linkedin.com/jobs/*"],
            "js": [
                "src/utils/storage.js",
                "src/content/ui.js",
                "src/content/main.js"
            ],
            "run_at": "document_idle"
        }
    ],

    "permissions": ["storage"],

    "host_permissions": [
        "https://www.linkedin.com/*",
        "http://localhost:8000/*"
    ],

    "action": {
        "default_popup": "popup/popup.html"
    }
}